{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(nix flake check:*)",
      "Bash(nix flake show:*)",
      "Bash(nix build:*)",
      "Bash(nix eval:*)",
      "Bash(nix fmt:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(nix run .#write-flake:*)",
      "Bash(nix flake lock:*)",
      "Bash(nix develop:*)",
      "Bash(just lint:*)",
      "Bash(just check:*)",
      "Bash(just build:*)",
      "Bash(statix check:*)",
      "Bash(deadnix:*)",
      "Bash(actionlint:*)",
      "Bash(shellcheck:*)",
      "Bash(nvd diff:*)",
      "Bash(nix-diff:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(nixos-rebuild:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
